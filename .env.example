# Which provider to use: openai | anthropic | local -> defaults to openai
LLM_PROVIDER="openai"

# --- OpenAI ---
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL="gpt-4o-mini"

# --- Anthropic (OpenAI-compatible endpoint) ---
#ANTHROPIC_API_KEY="your-anthropic-key"
#ANTHROPIC_MODEL="your-anthropic-model"

# --- Local model (Ollama / LM Studio / vLLM / llama.cpp) ---
# Ollama default endpoint shown below
#LOCAL_BASE_URL="http://localhost:11434/v1"
#LOCAL_MODEL="llama3.1"
#LOCAL_API_KEY is optional for most local servers